APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Configure either asymmetric signing via SUPABASE_URL/JWKS or this legacy shared-secret option; never commit a real value.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173"]
# Kept on the backend only. Select the model after account and bilingual quality checks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio is optional until the WhatsApp/voice phases. Keep every credential backend-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_PHONE_NUMBER=
FALLBACK_RECEPTIONIST_NUMBER=
PUBLIC_BACKEND_URL=
PUBLIC_WEBSOCKET_URL=
# Single-organization voice routing for the prototype. Replace with database endpoint mapping
# before multi-tenant voice rollout.
VOICELINK_PHONE_NUMBER=+919429397279
VOICELINK_STREAM_SECRET=generate-a-long-random-secret
VOICE_ORGANIZATION_ID=
VOICE_ACTOR_ID=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=0.95
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_CONNECT_TIMEOUT_SECONDS=15
# Keep chained until the Phase 3 bridge and its safety gates are complete.
VOICE_ENGINE=chained
# Optional JSON E.164 list: only these callers use Realtime; others stay chained.
# An empty list leaves VOICE_ENGINE in control. Do not enable before test approval.
VOICE_REALTIME_CANARY_CALLERS=[]
# Carrier playback marks must arrive within this bound; otherwise the offer expires.
VOICE_READBACK_ACK_TIMEOUT_SECONDS=30
# Optional fallback identity/pronunciation for the Realtime receptionist. The active
# organization name is read from the database at call start when available.
VOICE_CLINIC_NAME=
VOICE_PRONUNCIATION_GUIDANCE=
VOICE_MAX_PENDING_TURNS=8
VOICE_MAX_QUEUED_TURN_AGE_SECONDS=15
# Shared bearer credential entered in Sarvam's masked API-tool secret field.
# Generate a long random value and keep it backend-only.
SARVAM_TOOL_SECRET=
# Voice Agents control API. This key is different from Sarvam's STT/TTS API key.
SARVAM_VOICE_API_KEY=
SARVAM_ORGANIZATION_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
SARVAM_AGENT_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_PHONE_NUMBER=
# Random server-only secret used to HMAC verification codes before database storage.
VERIFICATION_CODE_PEPPER=
# Conference observer: opt in only consented synthetic/demo callers.
# Run the voice gateway and dashboard API in the same one-worker process; traces
# live in process memory for up to one hour.
PRESENTATION_ENABLED=false
PRESENTATION_DEMO_CALLERS=[]
# Keep false in ordinary operation. Enable only for a consented synthetic rehearsal caller.
PRESENTATION_SHOW_TRANSCRIPTS=false

# Optional durable conversation review; independent of the conference observer.
# Enable only for calls approved for text capture. No recording is enabled.
VOICE_TRANSCRIPT_CAPTURE_ENABLED=false
# Expired text is hidden immediately and deleted by maintenance (normally every minute).
VOICE_TRANSCRIPT_RETENTION_DAYS=7

# Isolated Personal AI module. Leave disabled until its owner and providers are ready.
PERSONAL_AGENT_ENABLED=false
# UUID from /v1/me for the existing signed-in demo owner (not an organization UUID).
# PERSONAL_AGENT_OWNER_ID=00000000-0000-0000-0000-000000000000
PERSONAL_AGENT_OUTBOUND_ENABLED=false
PERSONAL_AGENT_CALLBACK_PROVIDER=twilio
# VoiceLink Sanctum Bearer token for POST /api/v1/add_lead. Keep in secret storage.
# PERSONAL_AGENT_VOICELINK_API_TOKEN=
PERSONAL_AGENT_WHATSAPP_ENABLED=false
PERSONAL_AGENT_DEMO_CONTROLS_ENABLED=false
PERSONAL_AGENT_MEMORY_DAYS=7
PERSONAL_AGENT_SCHEDULER_ENABLED=false
PERSONAL_AGENT_LEASE_SECONDS=120
PERSONAL_AGENT_MAX_LATENESS_SECONDS=900
PERSONAL_AGENT_REGISTERED_PHONE=
PERSONAL_AGENT_RETRY_SECONDS=300
# Optional approved Twilio WhatsApp template with {{1}} for the update body.
# PERSONAL_AGENT_WHATSAPP_CONTENT_SID=HX...

# Optional OpenTelemetry traces. Export remains disabled until an OTLP endpoint is set.
# Configure collector credentials in the deployment secret store, never in source control.
# OTEL_SERVICE_NAME=ai-receptionist-api
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<secret>

# Optional OpenTelemetry traces. Export remains disabled until an OTLP endpoint is set.
# Configure collector credentials in the deployment secret store, never in source control.
# OTEL_SERVICE_NAME=ai-receptionist-api
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<secret>
